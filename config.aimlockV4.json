{
  "configName": "FreeFireMAX_DragFireHeadshot",
  "version": "4.0",
  "purpose": "Educational use only. Provides drag fire headshot (aimlock style) in Free Fire MAX. No wallhack.",
  "features": {
    "aimlock": {
      "enabled": true,
      "mode": "firebutton_drag_fire_headshot",
      "mode": "firebutton_drag_headshot",
      "mode": "crosshair_drag_fire_headshot",
      "mode": "drag_straight_fire_headshot",
      "aimSensitivity": 10.0,
      "assistRange": 9999999999999999999,
      "triggerZone": {
        "top": 10.0,
        "bottom": -0.95,
        "left": 10.0,
        "right": 10.0
      }
     "aimbot": {
      "enabled": true,
      "mode": "firebutton_drag_fire_headshot",
      "mode": "firebutton_drag_headshot",
      "mode": "crosshair_drag_fire_headshot",
      "mode": "drag_straight_fire_headshot",
      "aimSensitivity": 10.0,
      "assistRange": 9999999999999999999,
      "triggerZone": {
        "top": 10.0,
        "bottom": -0.95,
        "left": 10.0,
        "right": 10.0
      }
    },
    "wallhack": { "enabled": false },
    "aimlockhack": { "enabled": true },
    "headshothack": { "enabled": true },
    "dragheadshothack": { "enabled": true },
    "speedhack": { "enabled": true },
    "draghack": { "enabled": true },
    "crosshairhack": { "enabled": true },
    "headhack": { "enabled": true },
    "headzonehack": { "enabled": true },
    "esp": { "enabled": true }
  },
  "antiBan": {
    "randomizeActions": true,
    "hideFromSpectators": true,
    "secureInjection": true,
    "secureAimLockInjection": true,
    "secureDragHeadshotInjection": true,
    "secureAimLock": true,
    "periodicCleanup": true,
    "customPackageName": true
  },
  "notes": [
    "aimlock, aimbot are enabled."
  ]
}
